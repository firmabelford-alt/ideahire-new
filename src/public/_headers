# Cloudflare Pages static responses, including the SPA and help center.
# Source restrictions need a separate compatibility review of inline boot
# scripts, PDF workers, and external integrations before being tightened.
/*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: usb=(), serial=(), hid=()
